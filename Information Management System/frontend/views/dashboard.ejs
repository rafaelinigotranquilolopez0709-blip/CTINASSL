<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Inventory Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <%- include('partials/sidebar') %>
    <main class="main-content">
      <div class="top-bar">
        <h1>Dashboard</h1>
        <a href="/products/add" class="btn btn-primary">+ Add Product</a>
      </div>

      <div class="card-grid">
        <div class="card">
          <h4>Total Products</h4>
          <p>1,234</p>
        </div>
        <div class="card">
          <h4>Low Stock Alert</h4>
          <p style="color: #ef4444;">23</p>
        </div>
        <div class="card">
          <h4>Categories</h4>
          <p>8</p>
        </div>
        <div class="card">
          <h4>Total Value</h4>
          <p>$456,789</p>
        </div>
      </div>

      <h2>Recent Product Inventory</h2>
      <table class="data-table" style="margin-top: 15px;">
        <thead>
          <tr>
            <th>Product Name</th>
            <th>Category</th>
            <th>Stock Quantity</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Laptop Pro</td>
            <td>Electronics</td>
            <td>45</td>
            <td>$1,299.00</td>
          </tr>
          <tr>
            <td>Smartphone X</td>
            <td>Electronics</td>
            <td>12</td>
            <td>$899.00</td>
          </tr>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>