        <tbody>
          <tr>
            <td>TechCorp Ltd.</td>
            <td>contact@techcorp.com</td>
            <td>+1 (555) 019-2834</td>
            <td>123 Tech Way, Silicon Valley</td>
            <td>
              <button class="btn btn-warning">Edit</button>
